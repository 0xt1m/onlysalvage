# Copy to .env and fill in. Loaded automatically by settings.py via
# python-dotenv. Never commit the real .env -- see .gitignore.

# --- Required in every environment ---

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Use a DIFFERENT value per environment -- never reuse a dev key in production.
DJANGO_SECRET_KEY=

# --- Required in production (DJANGO_DEBUG unset/False) ---

# "False" in production. Leave unset or "True" for local dev -- the code
# default is "False" (fail-safe) so a forgotten env var locks things down
# rather than leaking debug pages.
DJANGO_DEBUG=True

# Comma-separated real hostnames, e.g. "onlysalvage.com,www.onlysalvage.com".
# Ignored while DJANGO_DEBUG=True (defaults to "*" for local/LAN dev then).
DJANGO_ALLOWED_HOSTS=

# Comma-separated, e.g. "https://onlysalvage.com,https://www.onlysalvage.com".
# Ignored while DJANGO_DEBUG=True.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# The real production frontend URL (used to build links in emails, etc).
FRONTEND_URL=http://localhost:3000

# --- Database ---

# "local" (default) -> localhost Postgres/PostGIS. "aws" -> DJANGO_DB_HOST_AWS
# below. Anything else is used directly as the hostname (e.g. set this to
# the real production RDS endpoint).
DJANGO_DB_HOST=local
DJANGO_DB_HOST_AWS=
DJANGO_DB_NAME=postgres
DJANGO_DB_USER=postgres
DJANGO_DB_PASSWORD=
DJANGO_DB_PORT=5432

# --- Redis (Celery broker + shared cache across gunicorn workers) ---

CELERY_BROKER_URL=redis://localhost:6379/0
# Required in production once gunicorn runs multiple worker processes -- see
# the comment above CACHES in settings.py. Use a different DB index than
# CELERY_BROKER_URL above, e.g. redis://localhost:6379/1.
REDIS_CACHE_URL=

# --- AWS (S3 media/static storage) ---

# Credentials themselves aren't read here -- boto3 picks them up from the
# environment (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY) or an EC2 instance
# IAM role automatically. Prefer an IAM role in production; only set access
# keys directly for local dev if you're not using `aws configure`.
AWS_STORAGE_BUCKET_NAME=onlysalvage-dev-media
AWS_S3_REGION_NAME=us-east-1

# --- Google ---

GOOGLE_OAUTH_CLIENT_ID=
# Billable key, no default -- required for address autocomplete to work.
GOOGLE_PLACES_API_KEY=
# Defaults to GOOGLE_PLACES_API_KEY above if unset.
GOOGLE_TRANSLATE_API_KEY=

# --- Twilio (phone verification via Verify) ---

# Accepts either a real Account SID (AC...) + Auth Token, or an API Key SID
# (SK...) + Secret -- both work identically for this. Falls back to printing
# a code to the console instead of sending a real SMS while unset, so local
# dev doesn't need a live Twilio account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Telegram (support/contact form delivery) ---

# Sending is skipped (submissions still saved to the DB) until both are set.
TELEGRAM_BOT_API_TOKEN=
TELEGRAM_CHAT_ID=
