# Copy to .env.local for dev, or .env.production.local for a production
# deploy (see deploy/onlysalvage-frontend.service). NEXT_PUBLIC_* vars are
# baked into the client bundle at build time -- `npm run build` must be
# re-run after changing one, and never put a real secret in one (it ends up
# readable in the browser).

# The real production domain, used to build canonical URLs/sitemap/OG tags.
# Defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# From Google Cloud Console -- OAuth client IDs are meant to be public (sent
# to the browser), so this is safe to bake into the client bundle.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# "true" to show the phone-verify step on sign-up/settings (the original
# behavior); unset/anything else hides it and lets people sign up, log in,
# and change their phone number without verifying one. Mirrors the
# backend's PHONE_VERIFICATION_ENABLED (onlysalvage_api/.env.example) --
# flip both together, or the UI and the API will disagree about whether the
# verify step is required. Requires `npm run build` to take effect.
NEXT_PUBLIC_PHONE_VERIFICATION_ENABLED=false

# How the BROWSER reaches the API -- see lib/apiUrl.ts. Leave unset for
# local dev (defaults to the Django dev server's own :8000 port on whatever
# host loaded the page). In production, nginx (see deploy/nginx.conf)
# proxies /api on the SAME origin as the frontend, so set this to exactly:
#   NEXT_PUBLIC_API_PATH=/api
NEXT_PUBLIC_API_PATH=

# How the NEXT.JS SERVER (middleware, RSC data fetching, sitemap generation)
# reaches the API -- always runs on the same machine/network as Django, so
# this is a plain internal URL, never exposed to the browser. Defaults to
# http://localhost:8000/api if unset -- in production, this MUST be set
# (e.g. http://127.0.0.1 talking to gunicorn's socket via nginx, or
# directly to the Django process's own address), or every server-rendered
# page load will try to reach localhost:8000 on the Next.js server itself.
INTERNAL_API_URL=http://localhost:8000/api
